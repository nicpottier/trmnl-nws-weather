<style>
  .wx { display: flex; flex: 1 1 0; min-height: 0; gap: 14px; }
  /* Room between stacked locations, so each one's lows/highs clearly belong to its own chart. */
  .wx + .wx { padding-top: 18px; }
  .screen--lg .wx + .wx { padding-top: 32px; }
  /* A little air above the top chart's dates. */
  .wx:first-child .wx__chart { padding-top: 3px; }
  .screen--lg .wx:first-child .wx__chart { padding-top: 6px; }
  .wx__now { position: relative; flex: 0 0 22%; display: flex; flex-direction: column; justify-content: center; min-width: 0; gap: 2px; }
  /* "Updated 8:05 AM" sits in the bottom-left corner of the last location's column, below its centered content. */
  .wx__now--updated .wx__left { padding-bottom: 16px; box-sizing: border-box; }
  .screen--lg .wx__now--updated .wx__left { padding-bottom: 22px; }
  .wx__updated { position: absolute; left: 0; bottom: 0; }
  .wx__chart { flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; }
  .wx__row { display: flex; padding-left: var(--wx-axis); }
  .wx__row > * { flex: 1 1 0; display: flex; align-items: center; justify-content: center; gap: 4px; min-width: 0; white-space: nowrap; }
  .wx__body { display: flex; flex: 1 1 auto; min-height: 0; }
  .wx__axis { flex: 0 0 var(--wx-axis); position: relative; }
  .wx__axis > span { position: absolute; right: 6px; transform: translateY(-50%); }
  .wx__plot { position: relative; flex: 1 1 auto; border-bottom: 2px solid currentColor; }
  /* Above the past shading, so day lines and bars show through it. */
  .wx__bars { position: absolute; inset: 0; z-index: 1; display: flex; }
  .wx__bars-day { position: relative; flex: 1 1 0; display: flex; align-items: flex-end; gap: 2px; padding: 0 2px; }
  /* Day lines belong to the bar groups, so they sit exactly midway between neighboring days' bars. */
  .wx__bars-day + .wx__bars-day::before {
    content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 1px; transform: translateX(-50%);
    background: repeating-linear-gradient(to bottom, currentColor 0 2px, transparent 2px 6px);
  }
  .wx__past { position: absolute; top: 0; bottom: 0; left: 0; }
  .wx__dot {
    position: absolute; right: 0; z-index: 2; width: 14px; height: 14px; border-radius: 50%;
    transform: translate(50%, -50%); box-shadow: 0 0 0 3px #fff;
  }
  .wx__bars-day > div { flex: 1 1 0; }
  .wx__plot svg { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; overflow: visible; }
  .wx__icon { display: block; flex: none; overflow: visible; }
  .screen--lg .wx__now .value { line-height: 0.85; }
  .wx-screen { --wx-axis: 34px; }
  .wx__left { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 3px; height: 100%; }
  .screen--lg .wx__left { gap: 5px; }
  .wx__ic--xl svg { width: 38px; height: 38px; display: block; }
  .screen--lg .wx__ic--xl svg { width: 120px; height: 120px; stroke-width: 1.2; }
  /* The high and low sit beside the current temperature, high level with its top, low with its bottom. */
  .wx__temps { display: flex; align-items: stretch; gap: 10px; }
  .wx__hilo { display: flex; flex-direction: column; justify-content: space-between; padding: 9px 0 8px; }
  .screen--lg .wx__hilo { padding: 3px 0; }
  .wx__row > .wx__lohi { gap: 12px; }
  .wx__row > .wx__amounts { flex-direction: column; justify-content: flex-start; gap: 0; }
  .wx--compact { flex-direction: column; gap: 2px; }
  .wx--compact .wx__now { flex: none; flex-direction: row; align-items: center; gap: 8px; }
  .wx--compact .wx__row > *, .wx--compact .wx__row > .wx__lohi { flex-direction: column; gap: 0; }
</style>

{% comment %} Line icons for the condition names the service returns (see server/glance.go). {% endcomment %}
{% template wx_icon %}
<svg class="wx__icon" width="{{ size | default: 28 }}" height="{{ size | default: 28 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="{{ name }}">
  {% case name %}
  {% when 'clear' %}
    <circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/>
  {% when 'night' %}
    <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"/>
  {% when 'partly' %}
    <circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M1.5 8H3M3.4 3.4l1 1M12.6 3.4l-1 1M3.4 12.6l1-1"/><path d="M9 21h8.5a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 8.4 15 3 3 0 0 0 9 21z"/>
  {% when 'night_partly' %}
    <path d="M11.5 8.5A4.5 4.5 0 0 1 5.5 2.6 4.5 4.5 0 1 0 11.5 8.5z"/><path d="M9 21h8.5a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 8.4 15 3 3 0 0 0 9 21z"/>
  {% when 'rain' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M8 17.5l-1 3M12 17.5l-1 3M16 17.5l-1 3"/>
  {% when 'sprinkles' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M8.5 18l-.5 1.5M12.5 18l-.5 1.5M16.5 18l-.5 1.5"/>
  {% when 'flurries' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M8.5 19h.01M12.5 19h.01M16.5 19h.01" stroke-width="3"/>
  {% when 'snow' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M8 18h.01M12 18h.01M16 18h.01M10 21.5h.01M14 21.5h.01" stroke-width="3"/>
  {% when 'sleet' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M8 17.5l-1 3M16 17.5l-1 3"/><path d="M12 18.5h.01" stroke-width="3"/>
  {% when 'storm' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M13 14.5l-3 4h4l-3 4"/>
  {% when 'fog' %}
    <path d="M6.5 14.5h11a4 4 0 0 0 .4-8A6 6 0 0 0 6.3 7.5a3.5 3.5 0 0 0 .2 7z"/><path d="M3 17.5h18M5 21h14"/>
  {% when 'wind' %}
    <path d="M3 9h11a3 3 0 1 0-3-3M3 15h15a3 3 0 1 1-3 3M3 12h7"/>
  {% else %}
    <path d="M6.5 18h11a4.5 4.5 0 0 0 .4-9A6.5 6.5 0 0 0 6.3 10a4 4 0 0 0 .2 8z"/>
  {% endcase %}
</svg>
{% endtemplate %}

{% comment %}
  One location: current conditions on the left; on the right a week-long chart with the hourly
  temperature line (and freezing line) over 6-hour snow and rain bars (measured at nearby
  stations in the shaded past, forecast after), daily highs/lows above it, and each day's snow/rain amounts below. Positions and paths come precomputed from the service.
  Params: loc (one entry of locations), compact (true for the small layouts), updated (when
  set, an "Updated <time>" note under this location's left column; pass it for the last one),
  show_dates (the day names; stacked locations share them, so only the first shows them).
{% endcomment %}
{% template wx_location %}
{% if loc.error %}
<div class="wx">
  <div class="wx__now"><span class="title title--small">{{ loc.location }}</span></div>
  <div class="wx__chart flex--center-y"><span class="description">Forecast unavailable: {{ loc.error }}</span></div>
</div>
{% else %}
{% assign chart = loc.chart %}
<div class="wx{% if compact %} wx--compact{% endif %}">
  <div class="wx__now{% if updated != blank %} wx__now--updated{% endif %}">
    {% if compact %}
      <span class="value value--small value--tnums">{{ loc.now.temp }}°</span>
      <span class="title title--small" data-clamp="1">{{ loc.location }}</span>
    {% endif %}
  {% unless compact %}
  {% assign today = loc.days[loc.today_index] %}
  {% capture amounts %}{{ today.amounts | join: " · " }}{% endcapture %}
  {% capture alert %}{% if loc.alerts.size > 0 %}<span class="label label--small label--inverted" data-clamp="1">{{ loc.alerts.first.event }}</span>{% endif %}{% endcapture %}
    <div class="wx__left">
      <div class="wx__ic wx__ic--xl">{% render "wx_icon", name: loc.now.icon, size: 64 %}</div>
      <span class="title title--small lg:title--base" data-clamp="1">{{ loc.location }}</span>
      <div class="wx__temps">
        <span class="value value--large lg:value--xxlarge value--tnums">{{ loc.now.temp }}°</span>
        <div class="wx__hilo">
          <span class="value value--xsmall lg:value--small font--bold">{{ today.hi }}°</span>
          <span class="value value--xsmall lg:value--small">{{ today.lo }}°</span>
        </div>
      </div>
      <span class="label label--small lg:label--base" data-clamp="2">{{ loc.now.short }}</span>
      {% if amounts != "" %}<span class="label label--small lg:label--base" data-clamp="1">{{ amounts }}</span>{% endif %}
      {% if loc.fresh_snow != blank %}<span class="label label--small lg:label--base" data-clamp="1">{{ loc.fresh_snow }}</span>{% endif %}
      {{ alert }}
    </div>
    {% if updated != blank %}<span class="wx__updated label label--small label--gray 1bit:text--black">Updated {{ updated }}</span>{% endif %}
  {% endunless %}
  </div>

  {% if chart %}
  <div class="wx__chart">
    {% if show_dates %}
    <div class="wx__row">
      {% for day in loc.days limit: chart.days %}
      <div><span class="label label--small lg:label--base">{% if compact %}{{ day.dow }}{% else %}{{ day.label }}{% endif %}</span></div>
      {% endfor %}
    </div>
    {% endif %}
    <div class="wx__row">
      {% for day in loc.days limit: chart.days %}
      <div class="wx__lohi"><span class="value value--xxsmall lg:value--xsmall">{{ day.lo }}°</span><span class="value value--xxsmall lg:value--xsmall font--bold">{{ day.hi }}°</span></div>
      {% endfor %}
    </div>
    <div class="wx__body">
      <div class="wx__axis">
        <span class="label label--small" style="top: 0%;">{{ chart.temp_max }}°</span>
        <span class="label label--small" style="top: 100%;">{{ chart.temp_min }}°</span>
        {% if chart.freeze_y and chart.freeze_y > 12 and chart.freeze_y < 88 %}<span class="label label--small" style="top: {{ chart.freeze_y }}%;">{{ chart.freeze_label }}</span>{% endif %}
      </div>
      <div class="wx__plot">
        <div class="wx__bars">
          {% comment %} Four 6-hour bars per day, grouped so each day's bars sit evenly inside its day lines. {% endcomment %}
          {% for day in loc.days limit: chart.days %}
          {% assign first = forloop.index0 | times: 4 %}
          <div class="wx__bars-day">{% for bar in chart.bars offset: first limit: 4 %}<div{% if bar.kind != "" %} class="bg--{{ bar.shade }}"{% endif %} style="height: {{ bar.h }}%;"></div>{% endfor %}</div>
          {% endfor %}
        </div>
        <div class="wx__past bg--gray-70" style="width: {{ chart.now_pct }}%;">
          {% if chart.now_y %}<div class="wx__dot bg--black" style="top: {{ chart.now_y }}%;"></div>{% endif %}
        </div>
        <svg viewBox="0 0 1000 100" preserveAspectRatio="none" fill="none" stroke="currentColor">
          {% if chart.freeze_y %}<line x1="0" y1="{{ chart.freeze_y }}" x2="1000" y2="{{ chart.freeze_y }}" stroke-width="1.5" stroke-dasharray="8 5" vector-effect="non-scaling-stroke"/>{% endif %}
          <path d="{{ chart.temp_path }}" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>
    </div>
    {% unless compact %}
    <div class="wx__row">
      {% for day in loc.days limit: chart.days %}
      <div class="wx__amounts">
        {% for amount in day.amounts %}<span class="label label--small lg:label--large">{{ amount }}</span>{% endfor %}
      </div>
      {% endfor %}
    </div>
    {% endunless %}
  </div>
  {% endif %}
</div>
{% endif %}
{% endtemplate %}

{% template wx_error %}
<div class="layout layout--col layout--center">
  <span class="title">Weather unavailable</span>
  <span class="description">{{ message | default: "No data from the NWS forecast service yet." }}</span>
</div>
{% endtemplate %}
