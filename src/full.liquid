{% if locations.size > 0 %}
<div class="layout layout--col layout--stretch wx-screen">
  {% for loc in locations %}
    {% if forloop.last %}{% assign updated = loc.updated %}{% else %}{% assign updated = "" %}{% endif %}
    {% render "wx_location", loc: loc, compact: false, show_dates: forloop.first, updated: updated %}
  {% endfor %}
</div>
{% else %}
{% render "wx_error", message: error %}
{% endif %}
